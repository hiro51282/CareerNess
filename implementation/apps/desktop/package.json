{
  "name": "desktop",
  "private": true,
  "version": "0.0.1",
  "description": "CareerNESS Editor desktop shell (Electron, thin-main per ADR-008)",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc",
    "start": "electron .",
    "stage": "bash scripts/stage.sh",
    "dist:linux": "pnpm run build && pnpm run stage && electron-builder --linux AppImage --publish never"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "electron": "^43.1.1",
    "electron-builder": "^26.15.3",
    "typescript": "^5.5.3"
  },
  "build": {
    "appId": "app.careerness.desktop",
    "productName": "CareerNESS",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**"
    ],
    "extraResources": [
      {
        "from": "resources/careerness",
        "to": "careerness"
      }
    ],
    "npmRebuild": false,
    "linux": {
      "target": "AppImage",
      "category": "Office"
    },
    "win": {
      "target": "nsis",
      "signAndEditExecutable": false
    },
    "mac": {
      "target": "dir",
      "identity": null
    }
  }
}
